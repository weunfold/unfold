{
  "name": "@rth/dsh-events",
  "version": "0.1.0",
  "private": true,
  "description": "Realtime event pane data for DSH: rth-agentd observer, plain-named bounded event window, causal links, SSE push, session-projection aggregates",
  "keywords": [
    "dsh-plugin",
    "cordis-plugin"
  ],
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./observer": "./src/observer.mjs",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "dependencies": {
    "@rth/dsh-sse": "0.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "~3.18.5",
    "zod": "~4.4.3"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "build:client": "node ../scripts/build-client.mjs dsh-events"
  }
}
