{
  "name": "@rth/dsh-mind",
  "version": "0.1.0",
  "private": true,
  "description": "The Mind stream for DSH: every observed RTH event as one plain sentence, grouped into episodes, with an audit panel per event and an append-only local suggestion log; read-only, from the rth-events observer feed and optional read-only journal files",
  "keywords": [
    "dsh-plugin",
    "cordis-plugin"
  ],
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "dependencies": {
    "@rth/dsh-sse": "0.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "build:client": "node ../scripts/build-client.mjs dsh-mind"
  }
}
